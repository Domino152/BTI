# Railway backend
NODE_ENV=production
PORT=8787
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=nta_portal
FRONTEND_ORIGINS=https://your-nta-frontend.vercel.app
SESSION_DAYS=7

# Dedicated document directory. Mount a persistent Railway volume at /data.
DOCUMENT_STORAGE_PATH=/data/documents

# Official NTA public-data synchronization
NTA_SYNC_INTERVAL_MINUTES=360
NTA_SYNC_SECRET=replace-with-a-long-random-secret
NTA_HOMEPAGE=https://www.nta.ac.in/
NTA_CONTACT_PAGE=https://www.nta.ac.in/ContactUs

# Vercel frontend
VITE_API_BASE_URL=https://your-nta-api.up.railway.app
